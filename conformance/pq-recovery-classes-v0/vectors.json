{
  "description": "pq-recovery-classes.v0 \u2014 rotation/kill/seed-rotation as recomputable falsifiable claims; each judged only against its declared class (cross-class confusion \u2192 rejected, never relabeled). Authority domains are in-predicate (per-agent SIWE vs deployer-tx fleet). derive() is the pinned key-derivation shape, not the live master seed.",
  "cases": [
    {
      "case_id": "rotation_valid_continuity",
      "expected_verdict": "continuity",
      "statement": {
        "class": "rotation",
        "owner": "0xabc0000000000000000000000000000000000abc",
        "auth": {
          "path": "siwe_owner",
          "identity": "0xabc0000000000000000000000000000000000abc"
        },
        "anchor_time": 1700,
        "revokes_content_address": "cc_e0",
        "superseded_by_content_address": "cc_e1"
      },
      "history_after": [
        {
          "content_address": "cc_e0",
          "binding_anchor_time": 1600,
          "revoked_at": 1700
        },
        {
          "content_address": "cc_e1",
          "binding_anchor_time": 1700,
          "revoked_at": null
        }
      ]
    },
