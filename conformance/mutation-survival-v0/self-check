#!/usr/bin/env bash
# SELF-APPLICATION. The suite above proves the primitive behaves correctly on crafted inputs. This
# proves the other half: that those vectors are LOAD-BEARING against the primitive's own guards —
# disable a guard in bin/recompute-mutation-survival and a named vector MUST red.
#
# It is the primitive applied to itself, which is bounded rather than circular: a mutant that breaks
# the tool badly enough to not run reports CRASHED / UNVERIFIABLE, never a pass. That is exactly what
# the CRASH-is-not-a-KILL relation buys. So this cannot launder a broken tool green; it also cannot
# certify one from nothing.
#
# Guards whose refutation no vector can witness are declared `probe`, not `guard`. They surface as
# named survivors in the coverage backlog instead of being quietly counted as covered — the same
# honesty the primitive demands of its targets.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"
tool="$root/bin/recompute-mutation-survival"

# A minimal staged tree rather than the repo root: same bytes (copied from the real file at run
# time), without copying a virtualenv once per mutant.
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
mkdir -p "$stage/bin" "$stage/conformance"
cp "$tool" "$stage/bin/recompute-mutation-survival"
cp -R "$here" "$stage/conformance/mutation-survival-v0"
rm -rf "$stage/conformance/mutation-survival-v0/self" "$stage/conformance/mutation-survival-v0/self-check"

python3 "$tool" \
  --dir "$stage" \
  --test-cmd "python3 conformance/mutation-survival-v0/check.py" \
  --mutations "$here/self/mutations.json" \
  ${1:+--out "$1"}
